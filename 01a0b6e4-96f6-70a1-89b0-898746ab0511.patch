+                            <kbd className="rounded-badge border border-borda-controle bg-fundo-afundado px-1.5 py-0.5 font-mono text-xs text-tinta">
+                              {tecla === "Ctrl" ? simbolo : tecla}
+                            </kbd>
+                          </span>
+                        ))}
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </section>
+          );
+        })}
+      </div>
+    </Modal>
+  );
+}

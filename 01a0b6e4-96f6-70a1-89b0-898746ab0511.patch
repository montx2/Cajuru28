+            Cancelar
+          </Botao>
+          <Botao variante="primaria" onClick={salvar} carregando={enviando}>
+            {edicao ? "Salvar alterações" : "Criar usuário"}
+          </Botao>
+        </div>
+      }
+    >
+      <div className="space-y-4">

+        className
+      )}
+    >
+      <span className="inline-flex min-w-0 items-center gap-1.5 text-xs font-medium leading-4">
+        {glifo ? <span className={cn("flex-none", pulsa && "animate-pulso")}>{glifo}</span> : null}
+        <span className="truncate">{rotulo}</span>

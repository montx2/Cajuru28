+        selecionado: opcao.valor === tema,
+        aoClicar: () => definir(opcao.valor),
+      }))}
+    >
+      <p className="px-3 pb-1 pt-1.5 text-2xs font-medium uppercase tracking-[.04em] text-tinta-fraca">Aparência</p>
+    </MenuSuspenso>
+  );
 }

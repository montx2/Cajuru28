+/* ── Documentos ──────────────────────────────────────────────────────────── */
+
+export function estadoDoDocumento(documento: Pick<DocumentoFiscal, "status" | "leiaute">): EstadoVisual {
+  if (documento.status === "cancelada") {
+    return { tom: "erro", rotulo: "Cancelada", icone: "negar" };
+  }
+  if (documento.leiaute === "resumo") {

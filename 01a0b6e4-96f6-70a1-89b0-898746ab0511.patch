+  const topo = useRef<HTMLDivElement | null>(null);
+
+  const selecionadas = useMemo(() => {
+    const bruto = ler("empresa_ids") || ler("empresa_id");
+    const ids = bruto
+      .split(",")
+      .map((valor) => Number(valor.trim()))
+      .filter((valor) => Number.isFinite(valor) && valor > 0);
+    return new Set(ids);
+  }, [ler]);
+

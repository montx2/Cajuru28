+
+  const dados = configuracao.dados;
+
+  return (
+    <div className="space-y-4">
+      <Cartao
+        titulo="Jettax"
+        descricao={`Base ${status.dados.base_url} · saúde ${status.dados.saude} · ${numero(status.dados.empresas_registradas)} registradas`}

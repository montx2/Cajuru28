# Copie para backend/.env:
#   cp backend/.env.example backend/.env
#
# O arquivo .env real NÃO deve ir para o Git.

DATABASE_URL=postgresql://notasflow:notasflow@db:5432/notasflow
REDIS_URL=redis://redis:6379/0

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Gere com:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=
# Opcional, somente numa rotação de chave: chaves antigas separadas por vírgula.
# Elas servem para ler certificados já gravados; novas senhas usam a chave acima.
VAULT_PREVIOUS_MASTER_KEYS=

DADOS_DIR=/data
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AMBIENTE_FISCAL=producao

# ---------------- Jettax 360 / Morfeu ----------------
# Configure o token exclusivamente no ambiente/secret manager do deploy.
# Nunca cole token, senha municipal ou certificado em código, CSV ou chat.
JETTAX_API_BASE_URL=https://morfeu-api.jettax.com.br
JETTAX_API_TOKEN=
JETTAX_TIMEOUT_SEGUNDOS=30
JETTAX_MAX_PAGINAS_POR_EXECUCAO=50
# Defina um valor longo e aleatório antes de cadastrar a URL de webhook na
# Jettax: https://SEU-DOMINIO/integracoes/jettax/webhooks/SEU_SEGREDO
JETTAX_WEBHOOK_SECRET=

# ---------------- Sincronismo automático (o antídoto do 656) ----------------
# Com "true" (padrão), o Celery Beat varre as empresas sozinho DENTRO da janela
# oficial de 1h por CNPJ+tipo. É isso que impede o operador de reconsultar antes
# da hora — reconsultar cedo é exatamente o que devolve cStat 656 e ZERA o
# cronômetro do bloqueio. Só desligue (false) se outro sistema já consulta os
# mesmos CNPJs (dois consumidores no mesmo CNPJ também causam 656).
SINCRONISMO_AUTOMATICO=true
SINCRONISMO_INTERVALO_MINUTOS=5
# Quantas empresas o agendador libera por tick (dilui a carga).
SINCRONISMO_LOTE_EMPRESAS=20

# Opcional: cria o primeiro usuário sozinho no boot da API
BOOTSTRAP_ESCRITORIO=Escritorio Cajuru
BOOTSTRAP_NOME=Administrador
BOOTSTRAP_EMAIL=admin@notasflow.local
BOOTSTRAP_SENHA=troque-esta-senha

# Opcional: alertas externos via webhook (Slack, Discord, n8n, gateway WhatsApp)
# Vazio = desligado.
ALERTA_WEBHOOK_URL=
ALERTA_WEBHOOK_MIN_NIVEL=atencao
ALERTA_WEBHOOK_COOLDOWN_MINUTOS=120
ALERTA_WEBHOOK_INTERVALO_MINUTOS=15

# ---------------- Backup (rotina diária do sistema) ----------------
# O job das BACKUP_HORA gera pacote com dump do banco + manifesto e mantém
# um espelho vivo dos XMLs/certificados. Teste de restauração: tela Saúde.
BACKUP_ATIVO=true
BACKUP_HORA=3
BACKUP_RETENCAO=14
BACKUP_ALERTA_HORAS=26

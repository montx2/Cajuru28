# Copie para backend/.env e preencha as chaves.
# NUNCA versionar o .env com chaves reais.

DATABASE_URL=postgresql://notasflow:notasflow@db:5432/notasflow
REDIS_URL=redis://redis:6379/0

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Gere com:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

DADOS_DIR=/data
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origens do frontend (CORS). Separe por vírgula se tiver mais de uma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ambiente fiscal dos importadores: producao | homologacao
AMBIENTE_FISCAL=producao

# Desenvolvimento local apenas. Copie para backend/.env e gere valores únicos:
#   cp backend/.env.example backend/.env
# Produção: use deploy/production.app.env.example como roteiro e secret manager.
# O arquivo .env real NÃO vai para o Git.

APP_ENV=development
DATABASE_URL=postgresql://notasflow:notasflow@db:5432/notasflow
REDIS_URL=redis://redis:6379/0

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Gere cada chave Fernet com:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=
# Nunca reutilize a chave do cofre como chave do backup.
BACKUP_ENCRYPTION_KEY=
# Opcional, durante rotação: chaves antigas de backups cifrados, separadas por vírgula.
BACKUP_PREVIOUS_ENCRYPTION_KEYS=
# Opcional, somente numa rotação de chave: chaves antigas separadas por vírgula.
VAULT_PREVIOUS_MASTER_KEYS=

DADOS_DIR=/data
# No compose de desenvolvimento este é o volume persistente `backups_local`.
BACKUP_DIR=/backups
ACCESS_TOKEN_EXPIRE_MINUTES=20
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_ATIVO=true
AMBIENTE_FISCAL=producao

# ---------------- Jettax 360 / Morfeu ----------------
# Configure o token exclusivamente no ambiente/secret manager do deploy.
# Nunca cole token, senha municipal ou certificado em código, CSV ou chat.
JETTAX_API_BASE_URL=https://morfeu-api.jettax.com.br
JETTAX_API_TOKEN=
JETTAX_TIMEOUT_SEGUNDOS=30
JETTAX_MAX_PAGINAS_POR_EXECUCAO=50
# Defina um valor longo e aleatório antes de cadastrar a URL de webhook na
# Jettax: https://SEU-DOMINIO/integracoes/jettax/webhooks/SEU_SEGREDO
JETTAX_WEBHOOK_SECRET=

# ---------------- Sincronismo automático (o antídoto do 656) ----------------
SINCRONISMO_AUTOMATICO=true
SINCRONISMO_INTERVALO_MINUTOS=5
SINCRONISMO_LOTE_EMPRESAS=20

# Opcional: cria o primeiro usuário sozinho no boot da API.
# Use uma senha aleatória com no mínimo 14 caracteres; remova os valores após
# o primeiro boot em produção.
BOOTSTRAP_ESCRITORIO=Escritório Principal
BOOTSTRAP_NOME=Administrador
BOOTSTRAP_EMAIL=
BOOTSTRAP_SENHA=

# Opcional: alertas externos via webhook (Slack, Discord, n8n, gateway WhatsApp)
ALERTA_WEBHOOK_URL=
ALERTA_WEBHOOK_MIN_NIVEL=atencao
ALERTA_WEBHOOK_COOLDOWN_MINUTOS=120
ALERTA_WEBHOOK_INTERVALO_MINUTOS=15

# ---------------- Backup recuperável ----------------
# Cada pacote é cifrado e inclui banco, XMLs, certificados cifrados e manifesto
# SHA-256. Em produção BACKUP_S3_BUCKET e BACKUP_DIR dedicado são obrigatórios.
BACKUP_ATIVO=true
BACKUP_HORA=3
BACKUP_RETENCAO=14
BACKUP_ALERTA_HORAS=26
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=notasflow
BACKUP_S3_REGION=us-east-1
# S3 compatível (MinIO etc.). Em produção deve ser HTTPS.
BACKUP_S3_ENDPOINT_URL=
# Prefira IAM role/identity federation. Só preencha se o provedor exigir chaves.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Opcional: ARN/id KMS; vazio usa SSE-S3 além da cifra Fernet local.
BACKUP_S3_KMS_KEY_ID=

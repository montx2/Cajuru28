# Copy to deploy/production.app.env (chmod 600). Do not commit the real file.
# Prefer injected variables from the deployment secret manager/IAM identity.
APP_ENV=production

# Same strong password as POSTGRES_PASSWORD in production.database.env.
DATABASE_URL=postgresql://notasflow:REPLACE_WITH_20PLUS_RANDOM_CHARACTERS@db:5432/notasflow
# Same strong password as REDIS_PASSWORD in production.redis.env.
REDIS_URL=redis://:REPLACE_WITH_20PLUS_RANDOM_CHARACTERS@redis:6379/0

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_48_BYTE_URLSAFE_SECRET
# Generate each independently: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=REPLACE_WITH_FERNET_KEY
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_FERNET_KEY
# Keep prior keys only while historic backups still need restoration.
BACKUP_PREVIOUS_ENCRYPTION_KEYS=
VAULT_PREVIOUS_MASTER_KEYS=

DADOS_DIR=/data
BACKUP_DIR=/backups
ACCESS_TOKEN_EXPIRE_MINUTES=20
# Browser and API sit behind the same Caddy domain; replace everywhere.
CORS_ORIGINS=https://fiscal.example.com.br
# Inclui `api` exclusivamente para o health check interno do Compose.
TRUSTED_HOSTS=fiscal.example.com.br,api
RATE_LIMIT_ATIVO=true
RATE_LIMIT_LOGIN_POR_MINUTO=8
RATE_LIMIT_LOGIN_POR_HORA=30
RATE_LIMIT_MUTACOES_POR_MINUTO=120
AMBIENTE_FISCAL=producao

# Optional Jettax 360 / Morfeu deployment secret. Leave blank to disable.
JETTAX_API_BASE_URL=https://morfeu-api.jettax.com.br
JETTAX_API_TOKEN=
JETTAX_TIMEOUT_SEGUNDOS=30
JETTAX_MAX_PAGINAS_POR_EXECUCAO=50
JETTAX_WEBHOOK_SECRET=

# Remove bootstrap values after the first successful boot. If used, both must
# be supplied via the secret manager and the password must be at least 14 chars.
BOOTSTRAP_ESCRITORIO=Escritorio Cajuru
BOOTSTRAP_NOME=Administrador
BOOTSTRAP_EMAIL=
BOOTSTRAP_SENHA=

# Off-site backup is mandatory while backup is active in production.
BACKUP_ATIVO=true
BACKUP_HORA=3
BACKUP_RETENCAO=14
BACKUP_ALERTA_HORAS=26
BACKUP_S3_BUCKET=replace-with-private-versioned-bucket
BACKUP_S3_PREFIX=notasflow/production
BACKUP_S3_REGION=us-east-1
# Blank for AWS; HTTPS endpoint for S3-compatible storage.
BACKUP_S3_ENDPOINT_URL=
# Prefer workload IAM role/instance identity. Fill these only if unavoidable.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Recommended: a customer managed KMS key/alias with least-privilege policy.
BACKUP_S3_KMS_KEY_ID=alias/notasflow-backups
